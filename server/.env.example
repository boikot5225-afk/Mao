# Copy this file to .env and fill in real values before deploying.
# Generate SESSION_SECRET with: openssl rand -hex 32

APP_PASSWORD=change-me
SESSION_SECRET=change-me-too
PORT=3000

# Optional: get notified in Telegram when a client submits a request via /new-order.html.
# Leave blank to disable notifications.
# 1. Message @BotFather on Telegram, send /newbot, follow the prompts -> you get a token.
# 2. Start a chat with your new bot and send it any message.
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates in a browser and copy the
#    "chat":{"id": ...} number from the response — that's TELEGRAM_CHAT_ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
